# Copy to .env and fill in. Never commit .env.

# --- LLM ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL_REASONING=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
USE_BEDROCK=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional alternatives to the key pair above (temporary credentials, or a Bedrock API key)
AWS_SESSION_TOKEN=
AWS_BEARER_TOKEN_BEDROCK=
# Effort per tier for structured JSON calls (cost and latency choice, not a guideline)
LLM_EFFORT_FAST=low
LLM_EFFORT_REASONING=medium

# --- Voice ---
TTS_PROVIDER=polly
POLLY_VOICE=Joanna

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Dashboard (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_AGENT_URL=http://localhost:8000
NEXT_PUBLIC_MATTERPORT_SDK_KEY=

# --- Mobile (Expo) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_DASHBOARD_URL=
EXPO_PUBLIC_AGENT_URL=

# --- Twilio: rings the alerted responder's phone (agent/sos/calls.py) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# A teammate's phone playing the dispatcher. Never a real emergency number.
DISPATCH_SIM_NUMBER=
# Public tunnel URL (ngrok / cloudflared) to this agent. Optional: lets the responder press 1 in the call to accept
PUBLIC_BASE_URL=

# --- Datasets ---
MATTERPORT_SDK_KEY=
# Matterport Model API (GraphQL) token pair, used by data/matterport.py to export a model's sweeps
MATTERPORT_API_KEY=
MATTERPORT_API_TOKEN=
# Path or API credentials: see data/README.md. Unset means the fallback building is used.
COSTAR_DATA_PATH=
VEXCEL_API_KEY=

# --- Tracing ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true

# --- Census ---
# Set with the team before the overnight run
CENSUS_BUDGET_USD=150
DETECT_MIN_CONF=0.35
# Upper edge of the borderline band that triggers a second-view check
DETECT_BORDERLINE_HIGH=0.6
WALK_SPEED_MPS=1.4
# Thresholds below are unverified defaults (spec section 20)
AED_ROUNDTRIP_TARGET_S=180
EXT_MAX_TRAVEL_M=22.9
EXIT_MAX_TRAVEL_M=61
DEMO_EVENT_DELAY_MS=0
# Scanner tiling and bulk work
TILES_PER_PANO=8
TILE_FOV_DEG=90
TILE_SIZE_PX=1024
FIRST_PASS_MAX_PX=768
SCAN_CONCURRENCY=4

# --- Live (camera -> nearest phone -> directions; agent/sos, vision/) ---
# Camera id sent by vision/ and registered by the dashboard. Any name works.
CAMERA_ID=webcam-1
CAMERA_INDEX=0
AGENT_URL=http://localhost:8000
# Optional fixed camera position. Unset: the dashboard /live page sends the laptop's location.
CAMERA_LAT=
CAMERA_LNG=
CAMERA_LABEL=
# Fall timing: a fall seen happening alerts after WITNESSED_DOWN_SECONDS on the floor; someone
# found already down (or lying down slowly) after DOWN_SECONDS.
WITNESSED_DOWN_SECONDS=0.8
DOWN_SECONDS=3
RESPONSIVE_HOLD_SECONDS=1.5
# Seconds a phone has to accept before the next nearest phone is alerted (longer when the alert
# also phones them through Twilio), and how recent a closed app's last location must be to call.
ACCEPT_TIMEOUT_SECONDS=20
ACCEPT_TIMEOUT_CALL_SECONDS=45
CALL_REACH_SECONDS=1800
# Danger zone kept clear around a fire, and the longest detour for grabbing an AED on the way.
FIRE_RADIUS_M=15
AED_MAX_DETOUR_M=400
PLACES_RADIUS_M=1000
# Fire/smoke model path (vision/fire.py); default .cache/models/fire-world.pt, built on first run. Use --no-fire to turn it off.
# VISION_FIRE_MODEL=
# Annotated webcam feed for the dashboard.
VISION_STREAM_PORT=8001
# Public OpenStreetMap services (override with your own if you have them).
VALHALLA_URL=
OVERPASS_URLS=
# Mobile/dashboard overrides (normally found automatically).
NEXT_PUBLIC_VISION_URL=
NEXT_PUBLIC_CAMERA_ID=

# --- Photon 2.0 (iMessage + voice over SIP) --- NOT USED since the live path rewrite; kept for reference
# Project API key and project id from app.beta.photon.codes
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
# Signing secret of the webhook destination pointing at PUBLIC_BASE_URL/photon/webhook
PHOTON_WEBHOOK_SECRET=
# Voice: the voice-enabled Photon SMS number (E.164) and its Voice profile's outbound SIP credentials
PHOTON_NUMBER=
PHOTON_SIP_SERVER=
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
